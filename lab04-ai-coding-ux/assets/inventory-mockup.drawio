<mxfile host="app.diagrams.net"><diagram id="Login" name="Login"><mxGraphModel page="1" pageWidth="1000" pageHeight="950"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="OMEGA INVENTORY — เข้าสู่ระบบ" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#1E40AF;fontColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="50" width="850" height="58" /></mxCell><mxCell id="3" value="ชื่อผู้ใช้ *" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;fontColor=#111827;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="120" width="850" height="58" /></mxCell><mxCell id="4" value="[ กรอกชื่อผู้ใช้ ]" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;fontColor=#111827;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="190" width="850" height="58" /></mxCell><mxCell id="5" value="! ระบุชื่อผู้ใช้ในช่องนี้" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;fontColor=#B45309;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="260" width="850" height="58" /></mxCell><mxCell id="6" value="รหัสผ่าน *" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;fontColor=#111827;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="330" width="850" height="58" /></mxCell><mxCell id="7" value="[ กรอกรหัสผ่าน ]   แสดงรหัสผ่าน" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;fontColor=#111827;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="400" width="850" height="58" /></mxCell><mxCell id="8" value="! รหัสผ่านไม่ถูกต้อง กรุณาลองอีกครั้ง" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;fontColor=#B45309;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="470" width="850" height="58" /></mxCell><mxCell id="9" value="เข้าสู่ระบบ" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#1E40AF;fontColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="540" width="850" height="58" /></mxCell><mxCell id="10" value="เข้าระบบไม่ได้? ติดต่อผู้ดูแล" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;fontColor=#111827;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="610" width="850" height="58" /></mxCell></root></mxGraphModel></diagram><diagram id="Dashboard" name="Dashboard"><mxGraphModel page="1" pageWidth="1000" pageHeight="950"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="OMEGA INVENTORY — ภาพรวมคลัง" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#1E40AF;fontColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="50" width="850" height="58" /></mxCell><mxCell id="3" value="ภาพรวม | เพิ่มสินค้า | ออกจากระบบ" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;fontColor=#111827;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="120" width="850" height="58" /></mxCell><mxCell id="4" value="ข้อมูลตัวอย่าง: จับต้องได้ 24 | ดิจิทัล 6 | สต็อกต่ำ 3" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;fontColor=#111827;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="190" width="850" height="58" /></mxCell><mxCell id="5" value="ค้นหาชื่อหรือรหัส [________]   ชนิด [ทั้งหมด]" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;fontColor=#111827;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="260" width="850" height="58" /></mxCell><mxCell id="6" value="รหัส | ชื่อ | ชนิด | คงเหลือ | สถานะ" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;fontColor=#111827;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="330" width="850" height="58" /></mxCell><mxCell id="7" value="P001 | ปากกา | จับต้องได้ | 4 ชิ้น | ! สต็อกต่ำ" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;fontColor=#B45309;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="400" width="850" height="58" /></mxCell><mxCell id="8" value="D001 | แบบฝึกหัด | ไฟล์ดิจิทัล | ไม่จำกัด | พร้อมขาย" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;fontColor=#111827;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="470" width="850" height="58" /></mxCell><mxCell id="9" value="เพิ่มสินค้า" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#1E40AF;fontColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="540" width="850" height="58" /></mxCell><mxCell id="10" value="สถานะว่าง: ยังไม่มีสินค้าในระบบ — เพิ่มสินค้ารายการแรก" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;fontColor=#111827;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="610" width="850" height="58" /></mxCell><mxCell id="11" value="ยืนยันคำสั่งซื้อ: จับต้องได้ → จำนวนและสถานะจัดส่ง" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;fontColor=#111827;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="680" width="850" height="58" /></mxCell><mxCell id="12" value="ดิจิทัล → เปิดดาวน์โหลดได้หลังยืนยันคำสั่งซื้อเท่านั้น" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;fontColor=#111827;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="750" width="850" height="58" /></mxCell></root></mxGraphModel></diagram><diagram id="Add-Product" name="Add Product"><mxGraphModel page="1" pageWidth="1000" pageHeight="950"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="OMEGA INVENTORY — เพิ่มสินค้า" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#1E40AF;fontColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="50" width="850" height="58" /></mxCell><mxCell id="3" value="* จำเป็นต้องกรอก" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;fontColor=#111827;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="120" width="850" height="58" /></mxCell><mxCell id="4" value="ชื่อสินค้า * [____________]   รหัสสินค้า * [____________]" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;fontColor=#111827;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="190" width="850" height="58" /></mxCell><mxCell id="5" value="ชนิดสินค้า * (●) จับต้องได้ (○) ไฟล์ดิจิทัล" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;fontColor=#111827;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="260" width="850" height="58" /></mxCell><mxCell id="6" value="หมวดหมู่ [เลือกหมวดหมู่]   ราคา * [_______] บาท" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;fontColor=#111827;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="330" width="850" height="58" /></mxCell><mxCell id="7" value="! ราคา: กรอกตัวเลขมากกว่า 0 บาท" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;fontColor=#B45309;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="400" width="850" height="58" /></mxCell><mxCell id="8" value="จับต้องได้: จำนวนเริ่มต้น * [___] ชิ้น | จุดแจ้งเตือน [___]" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;fontColor=#111827;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="470" width="850" height="58" /></mxCell><mxCell id="9" value="ดิจิทัล: ไฟล์สินค้า * [เลือกไฟล์] — ไม่มี stock ให้ตัด" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;fontColor=#111827;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="540" width="850" height="58" /></mxCell><mxCell id="10" value="รูปสินค้า (ไม่บังคับ) [เลือกภาพ]" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;fontColor=#111827;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="610" width="850" height="58" /></mxCell><mxCell id="11" value="ยกเลิก                         บันทึกสินค้า" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#1E40AF;fontColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="680" width="850" height="58" /></mxCell><mxCell id="12" value="✓ บันทึก ปากกา (P001) แล้ว — กลับไปดูรายการ" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;fontColor=#15803D;strokeColor=#CBD5E1;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="750" width="850" height="58" /></mxCell></root></mxGraphModel></diagram></mxfile>